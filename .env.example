# ============================================================
# Variables d'environnement — Projet PFE BTP
# Copier ce fichier en .env et adapter les valeurs
# IMPORTANT : Ne jamais committer le fichier .env
# ============================================================

# ── JWT ─────────────────────────────────────────────────────
# Secret partagé entre api-gateway et user-service (min 32 chars)
JWT_SECRET=btp-secret-key-for-jwt-signing-must-be-at-least-256-bits-long-for-hs256

# ── MongoDB ──────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=btppassword

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=btp
RABBITMQ_PASSWORD=btp123

# ── SMTP (notification-service) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=votre_app_password
